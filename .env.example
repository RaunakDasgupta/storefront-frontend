# Copy to .env.local and fill in. Anything left blank keeps using the built-in sample data (kept in the browser).
# Restart `npm run dev` after changing it: Vite reads these at start-up.

# One base URL: every resource below defaults to a path under it.
# For the storefront-backend API on this machine:  VITE_API_URL=http://localhost:8000/api/v1
VITE_API_URL=

# Or set a resource's full URL, which wins over the base URL (handy when they live on different servers).
# VITE_PRODUCTS_URL=      # default: <VITE_API_URL>/products
# VITE_ORDERS_URL=        # default: <VITE_API_URL>/orders
# VITE_CUSTOMER_AUTH_URL= # default: <VITE_API_URL>/auth
# VITE_ADMIN_AUTH_URL=    # default: <VITE_API_URL>/admin/auth
# VITE_PAYMENTS_URL=      # default: <VITE_API_URL>/payments
# VITE_IMPORT_URL=        # default: <VITE_API_URL>/import
